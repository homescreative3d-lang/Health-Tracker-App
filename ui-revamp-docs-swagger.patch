+                  const mime =
+                    f.type ||
+                    (
+                      {
+                        jpg: "image/jpeg",
+                        jpeg: "image/jpeg",
+                        png: "image/png",
+                        heic: "image/heic",
+                        heif: "image/heif",
+                      } as Record<string, string>
