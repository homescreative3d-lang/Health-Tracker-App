+
+/* ---------- Auth redesign: brand panel + form card ---------- */
+.auth-layout {
+  gap: 0;
+  padding: 0;
+  max-width: 1080px;
+  border-radius: 32px;
+  overflow: hidden;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  box-shadow: var(--shadow-lg);
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  min-height: min(640px, calc(100dvh - 140px));
+  align-items: stretch;
+  animation: dialog-in 500ms var(--ease-out);
+}
+.auth-copy {
+  position: relative;
+  max-width: none;
+  align-content: center;
+  padding: clamp(28px, 5vw, 56px);
+  background:
+    radial-gradient(420px 260px at 0% 100%, rgba(47, 163, 122, 0.35), transparent 70%),
+    radial-gradient(420px 260px at 100% 0%, rgba(91, 107, 224, 0.4), transparent 70%), #0f2a33;
+  color: #fff;
+  overflow: hidden;
+}
+.auth-copy::before {
+  content: "";
+  position: absolute;
+  inset: 0 0 auto;
+  height: 4px;
+  background: var(--day-ribbon);
+}
+.auth-copy h1 {
+  color: #fff;
+  font-size: clamp(1.8rem, 1.2rem + 2vw, 2.6rem);
+  letter-spacing: -0.035em;
+}
+.auth-copy p {
+  color: rgba(255, 255, 255, 0.78);
+}
+.auth-copy .feature-pills li {
+  color: rgba(255, 255, 255, 0.9);
+  font-weight: 500;
+}
+.auth-mark {
+  border-radius: 16px;
+  box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.08);
+}
+.auth-card {
+  border: 0;
+  border-radius: 0;
+  box-shadow: none;
+  align-content: center;
+  padding: clamp(24px, 5vw, 52px);
+}
+.main:has(.auth-layout) {
+  background:
+    radial-gradient(700px 400px at 90% 0%, rgba(91, 107, 224, 0.08), transparent 70%),
+    radial-gradient(700px 400px at 0% 100%, rgba(47, 163, 122, 0.08), transparent 70%), var(--bg);
+  min-height: calc(100dvh - var(--topbar-h) - var(--safe-top));
+}
+.narrow-card,
+.setup-card {
