+/* Landing page (signed-out). Uses the same tokens as the app. */
+.landing {
+  background: var(--surface);
+  color: var(--ink);
+  overflow-x: clip;
+}
+.landing-wrap {
+  width: min(1180px, 100% - clamp(32px, 6vw, 80px));
+  margin-inline: auto;
+}
+.btn.lg {
+  min-height: 52px;
+  padding: 0 26px;
+  font-size: 1.02rem;
+}
+.btn.light {
+  background: #fff;
+  color: var(--ink);
+}
+.btn.light:hover {
+  background: #f1f8f6;
+}
+.btn.outline-light {
+  color: #fff;
+  border-color: rgba(255, 255, 255, 0.5);
+}
+.btn.outline-light:hover {
+  background: rgba(255, 255, 255, 0.1);
+}
+
+/* ---------- Navbar ---------- */
+.landing-nav {
+  position: sticky;
+  top: 0;
+  z-index: 40;
+  padding-top: var(--safe-top);
+  background: rgba(255, 255, 255, 0.78);
+  backdrop-filter: saturate(1.5) blur(14px);
+  border-bottom: 1px solid transparent;
+  transition:
+    border-color var(--dur),
+    box-shadow var(--dur);
+}
+.landing-nav.scrolled {
+  border-color: var(--border);
+  box-shadow: 0 6px 24px rgba(15, 42, 51, 0.06);
+}
+.landing-nav-inner {
+  width: min(1180px, 100% - clamp(32px, 6vw, 80px));
+  margin-inline: auto;
+  height: 72px;
+  display: flex;
+  align-items: center;
+  gap: var(--space-6);
+}
+.landing-links {
+  display: flex;
+  gap: 4px;
+  margin-left: auto;
+}
+.landing-links > button {
+  min-height: 40px;
+  padding: 0 14px;
+  border-radius: var(--radius-pill);
+  font-weight: 500;
+  color: var(--ink-2);
+  transition:
+    background var(--dur-fast),
+    color var(--dur-fast);
+}
+.landing-links > button:hover {
+  background: var(--primary-tint);
+  color: var(--ink);
+}
+.landing-links-auth {
