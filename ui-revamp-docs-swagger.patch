+        ))}
+      </div>
+      <div className="pause-panel card">
+        <div className="pause-panel-copy">
+          <span className="pause-panel-icon">
+            <Clock3 size={19} />
+          </span>
+          <div>
+            <b>Pause a medicine</b>
