+
+/* ---------- Splash (session restore) ---------- */
+.splash {
+  min-height: 100dvh;
+  display: grid;
+  place-content: center;
+  justify-items: center;
+  gap: var(--space-4);
+  background:
+    radial-gradient(500px 300px at 50% 35%, rgba(11, 122, 110, 0.1), transparent 70%), var(--bg);
+  color: var(--muted);
+}
+.splash-word {
+  font-size: 1.8rem;
+  font-weight: 600;
+  letter-spacing: -0.04em;
+  color: var(--ink);
+  animation: rise 600ms 500ms var(--ease-out) both;
+}
+.splash-bar {
+  width: 180px;
+  height: 4px;
+  border-radius: 4px;
+  background: var(--border);
+  overflow: hidden;
+}
+.splash-bar span {
+  display: block;
+  height: 100%;
+  width: 40%;
+  border-radius: 4px;
+  background: var(--day-ribbon);
+  animation: splash-slide 1.4s ease-in-out infinite;
+}
+.splash p {
+  font-size: var(--text-sm);
+  animation: fade-in 400ms var(--ease-out);
+}
+@keyframes splash-slide {
+  from {
+    transform: translateX(-110%);
+  }
+  to {
+    transform: translateX(260%);
+  }
+}
+
+/* Animated logo: compartments fill in daypart order, then the check draws. */
+.logo-mark.animated .lm-cell {
+  transform-box: fill-box;
+  transform-origin: center;
+  animation: cell-in 520ms var(--ease-out) both;
+}
+.logo-mark.animated .c1 {
+  animation-delay: 80ms;
+}
+.logo-mark.animated .c2 {
+  animation-delay: 200ms;
+}
+.logo-mark.animated .c3 {
+  animation-delay: 320ms;
+}
+.logo-mark.animated .c4 {
+  animation-delay: 440ms;
+}
+.logo-mark.animated .lm-check {
+  stroke-dasharray: 1;
+  stroke-dashoffset: 1;
+  animation:
+    check-draw 520ms 640ms var(--ease-out) forwards,
+    check-breathe 2.4s 1.4s ease-in-out infinite;
+}
+@keyframes cell-in {
+  from {
+    transform: scale(0.2);
+    opacity: 0;
+  }
+}
+@keyframes check-draw {
+  to {
+    stroke-dashoffset: 0;
+  }
+}
+@keyframes check-breathe {
+  50% {
+    opacity: 0.75;
+  }
+}
+
+/* ---------- Skeletons ---------- */
+.skeleton {
+  display: block;
+  flex: none;
+  background: linear-gradient(90deg, #eef2f6 25%, #f7f9fb 45%, #eef2f6 65%);
+  background-size: 300% 100%;
+  animation: shimmer 1.3s ease-in-out infinite;
+}
+.skeleton-list {
+  overflow: hidden;
+}
+.skeleton-row {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  padding: var(--space-4);
+}
+.skeleton-row + .skeleton-row {
+  border-top: 1px solid var(--border);
+}
+.skeleton-lines {
+  flex: 1;
+  display: grid;
+  gap: 8px;
+}
+@keyframes shimmer {
+  from {
+    background-position: 100% 0;
+  }
+  to {
+    background-position: 0 0;
+  }
+}
