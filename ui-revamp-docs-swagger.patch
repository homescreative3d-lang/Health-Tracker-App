+      return setLocalError("Enter your name (2–80 characters).");
+    setBusy(true);
+    try {
+      const r =
+        mode === "signin"
+          ? await api.login({ email: em, password })
+          : await api.register({
+              email: em,
+              password,
+              displayName: name.trim(),
