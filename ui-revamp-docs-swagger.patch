+      </Field>
+      {error && <InlineError>{error}</InlineError>}
+      <button
+        className="btn primary full"
+        onClick={async () => {
+          if (!/^\S+@\S+\.\S+$/.test(e.trim())) return setError("Enter a valid email address.");
+          try {
