+                      <FileImage size={15} />
+                      Gallery / files
+                      <input
+                        type="file"
+                        multiple
+                        accept=".jpg,.jpeg,.png,.heic,.heif,.pdf,.xlsx,image/jpeg,image/png,image/heic,image/heif,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
+                        hidden
