+              <option key={m.id} value={m.id}>
+                {m.name}
+              </option>
+            ))}
+          </select>
+          <button
+            className="btn soft"
+            disabled={!meds.length}
+            onClick={() => {
+              const el = document.getElementById("pause-med") as HTMLSelectElement | null;
+              if (el && el.value) onPause(el.value, selectedDate);
+            }}
+          >
+            <Clock3 size={16} />
