+              <FileImage size={15} />
+              Gallery
+              <input
+                type="file"
+                accept=".jpg,.jpeg,.png,.heic,.heif,image/jpeg,image/png,image/heic,image/heif"
+                hidden
+                onChange={(e) => {
+                  const f = e.target.files?.[0];
+                  if (!f) return;
+                  if (f.size > 1024 * 1024) {
+                    setMsg("Image must be 1 MB or smaller.");
+                    return;
