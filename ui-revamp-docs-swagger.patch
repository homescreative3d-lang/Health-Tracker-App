diff --git a/frontend/src/styles/app-theme.css b/frontend/src/styles/app-theme.css
new file mode 100644
index 0000000..9cdb50c
--- /dev/null
+++ b/frontend/src/styles/app-theme.css
@@ -0,0 +1,1137 @@
+/*
+ * In-app theme layer: carries the landing page's visual language into the signed-in app.
+ * Dark ink navigation, the day ribbon, pill-organizer compartments, illustrated headers,
+ * and motion that responds to what the user does.
+ */
+
+/* ---------- Canvas ---------- */
+.main.main-hub {
+  background:
+    radial-gradient(900px 480px at 100% -10%, rgba(91, 107, 224, 0.07), transparent 70%),
+    radial-gradient(800px 480px at -10% 110%, rgba(47, 163, 122, 0.07), transparent 70%), var(--bg);
+  min-height: calc(100dvh - var(--topbar-h) - var(--safe-top));
+}
+.topbar {
+  border-bottom: 0;
+}
+.topbar::after {
+  content: "";
+  position: absolute;
+  inset: auto 0 0 0;
+  height: 3px;
+  background: var(--day-ribbon);
+  opacity: 0.9;
+}
+.page-head h1 {
+  font-weight: 700;
+  letter-spacing: -0.035em;
+}
+
+/* ---------- Dark ink sidebar ---------- */
+.sidebar {
+  background:
+    radial-gradient(260px 220px at 0% 100%, rgba(47, 163, 122, 0.22), transparent 70%),
+    radial-gradient(260px 220px at 100% 0%, rgba(91, 107, 224, 0.22), transparent 70%), #0f2a33;
+  border-right: 0;
+  color: #fff;
+}
+.side-intro {
+  position: relative;
+  background: rgba(255, 255, 255, 0.06);
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  overflow: hidden;
+}
+.side-intro::before {
+  content: "";
+  position: absolute;
+  inset: 0 0 auto;
+  height: 3px;
+  background: var(--day-ribbon);
+}
+.side-intro small {
+  color: #7fd6c4;
+}
+.side-intro b {
+  color: #fff;
+}
+.side-intro .muted {
+  color: rgba(255, 255, 255, 0.6);
+}
+.side-nav .nav-item {
+  color: rgba(255, 255, 255, 0.72);
+  border-radius: var(--radius-pill);
+}
+.side-nav .nav-item:hover {
+  background: rgba(255, 255, 255, 0.08);
+  color: #fff;
+}
+.side-nav .nav-item.active {
+  background: #fff;
+  color: var(--ink);
+  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
+}
+.side-nav .nav-item.active svg {
+  color: var(--primary);
+}
+.side-nav .nav-item.active::before {
+  display: none;
+}
+.guide-link {
+  color: rgba(255, 255, 255, 0.6);
+  border-radius: var(--radius-pill);
+}
+.guide-link:hover {
+  color: #fff;
+  background: rgba(255, 255, 255, 0.08);
+}
+@media (max-width: 1023px) {
+  .side-nav .nav-item {
+    border-radius: var(--radius);
+  }
+}
+
+/* ---------- Dark bottom tab bar (phones) ---------- */
+@media (max-width: 639px) {
+  .mobile-tabs {
+    left: 10px;
+    right: 10px;
+    bottom: calc(10px + var(--safe-bottom));
+    padding-bottom: 0;
+    border-radius: 22px;
+    background: rgba(15, 42, 51, 0.96);
+    border: 0;
+    box-shadow: 0 14px 34px rgba(15, 42, 51, 0.35);
+    overflow: hidden;
+  }
+  .mobile-tabs::before {
+    content: "";
+    position: absolute;
+    inset: 0 0 auto;
+    height: 3px;
+    background: var(--day-ribbon);
+  }
+  .mobile-tabs .nav-item {
+    color: rgba(255, 255, 255, 0.6);
+  }
+  .mobile-tabs .nav-item.active {
+    color: #fff;
+  }
+  .mobile-tabs .nav-item.active svg {
+    background: rgba(255, 255, 255, 0.14);
+    color: #7fd6c4;
+  }
+  .dashboard-main {
+    padding-bottom: calc(var(--tabbar-h) + var(--safe-bottom) + 36px);
+  }
+  .toast {
+    bottom: calc(var(--tabbar-h) + var(--safe-bottom) + 24px);
+  }
+}
+
+/* ---------- Cards feel like the landing ---------- */
+.card {
+  border-radius: var(--radius-lg);
+  border-color: var(--border);
+  box-shadow:
+    0 1px 2px rgba(15, 42, 51, 0.04),
+    0 10px 30px -18px rgba(15, 42, 51, 0.18);
+}
+.med-card,
+.patient-summary-row,
+.profile-action {
+  transition:
+    transform var(--dur) var(--ease-out),
+    box-shadow var(--dur),
+    border-color var(--dur),
+    background var(--dur-fast);
+}
+.med-card:hover,
+.patient-summary-row:hover {
+  transform: translateY(-3px);
+  box-shadow: var(--shadow);
+}
+
+/* ---------- Illustrations ---------- */
+.empty-art {
+  margin-bottom: var(--space-2);
+}
+.art-bob {
+  animation: phone-float 3.6s ease-in-out infinite;
+}
+.art-ring {
+  transform-box: fill-box;
+  transform-origin: 50% 0;
+  animation: bell-ring 3s ease-in-out infinite;
+}
+.empty-card .empty-art + b {
+  font-size: var(--text-lg);
+}
+.medicine-art {
+  flex: none;
+  display: block;
+}
+
+/* ---------- Today hero ---------- */
+.today-hero {
+  position: relative;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(220px, 340px);
+  align-items: center;
+  gap: var(--space-5);
+  padding: clamp(18px, 3vw, 28px);
+  border-radius: 28px;
+  background: #fff;
+  border: 1px solid var(--border);
+  box-shadow: var(--shadow);
+  overflow: hidden;
+}
+.today-hero::before {
+  content: "";
+  position: absolute;
+  inset: 0 0 auto;
+  height: 4px;
+  background: var(--day-ribbon);
+}
+.today-hero-copy {
+  display: grid;
+  gap: 6px;
+  justify-items: start;
+}
+.today-hero h1 {
+  font-size: clamp(1.6rem, 1.1rem + 1.8vw, 2.3rem);
+  font-weight: 700;
+  letter-spacing: -0.035em;
+}
+.today-hero p {
+  color: var(--muted);
+  margin-bottom: var(--space-2);
+}
+.sky-scene {
+  width: 100%;
+  height: auto;
+  display: block;
+}
+.sky-halo {
+  animation: heartbeat 4s ease-in-out infinite;
+  transform-box: fill-box;
+  transform-origin: center;
+}
+.sky-star {
+  animation: twinkle 2.6s ease-in-out infinite;
+}
+@keyframes twinkle {
+  50% {
+    opacity: 0.25;
+  }
+}
+
+/* ---------- Progress card ---------- */
+.progress-card {
+  position: relative;
+  justify-content: flex-start;
+  gap: clamp(16px, 3vw, 32px);
+  padding: var(--space-5) var(--space-6);
+  overflow: hidden;
+}
+.progress-card .progress-ring {
+  --size: 124px;
+  order: -1;
+  background:
+    radial-gradient(closest-side, #fff 80%, transparent 81%),
+    conic-gradient(
+      var(--logo-morning),
+      var(--logo-afternoon) calc(var(--fill) * 0.5%),
+      var(--primary) calc(var(--fill) * 1%),
+      var(--primary-soft) 0
+    );
+}
+.progress-ring span {
+  display: grid;
+  justify-items: center;
+  line-height: 1.1;
+}
+.progress-ring b {
+  font-size: 1.6rem;
+  letter-spacing: -0.04em;
+}
+.progress-ring small {
+  color: var(--muted);
+  font-size: var(--text-xs);
+}
+.progress-copy {
+  flex: 1;
+  min-width: 0;
+}
+.progress-headline {
+  font-size: var(--text-lg);
+  letter-spacing: -0.01em;
+}
+.progress-bar {
+  display: flex;
+  height: 10px;
+  border-radius: 999px;
+  overflow: hidden;
+  background: var(--primary-soft);
+  gap: 2px;
+}
+.progress-bar .seg {
+  flex-basis: 0;
+  transition: flex-grow 700ms var(--ease-out);
+}
+.progress-bar .taken {
+  background: var(--logo-afternoon);
+}
+.progress-bar .missed {
+  background: var(--logo-evening);
+}
+.progress-bar .remaining {
+  background: var(--primary-soft);
+}
+.progress-card.is-complete {
+  background:
+    radial-gradient(400px 200px at 0% 0%, rgba(47, 163, 122, 0.14), transparent 70%), #fff;
+  border-color: #bfe2cb;
+}
+
+/* Confetti */
+.celebration {
+  position: absolute;
+  left: 86px;
+  top: 50%;
+  pointer-events: none;
+  z-index: 2;
+}
+.celebration i {
+  position: absolute;
+  width: 9px;
+  height: 9px;
+  border-radius: 3px;
+  background: var(--logo-morning);
+  rotate: calc(var(--i) * (360deg / var(--n)));
+  animation: confetti 1.3s var(--ease-out) forwards;
+}
+.celebration i:nth-child(4n + 2) {
+  background: var(--logo-afternoon);
+}
+.celebration i:nth-child(4n + 3) {
+  background: var(--logo-evening);
+}
+.celebration i:nth-child(4n + 4) {
+  background: var(--logo-night);
+}
+@keyframes confetti {
+  0% {
+    transform: translateY(0) scale(1);
+    opacity: 1;
+  }
+  100% {
+    transform: translateY(-110px) scale(0.3) rotate(160deg);
+    opacity: 0;
+  }
+}
+
+/* ---------- Dose compartments ---------- */
+.dose-group {
+  --hue: var(--logo-morning);
+  padding: 10px;
+  border-radius: 24px;
+  background: color-mix(in srgb, var(--hue) 13%, #fff);
+}
+.part-afternoon {
+  --hue: var(--logo-afternoon);
+}
+.part-evening {
+  --hue: var(--logo-evening);
+}
+.part-night {
+  --hue: var(--logo-night);
+}
+.dose-group h4 {
+  padding: 2px 8px 4px;
+}
+.dose-group-count {
+  background: #fff;
+}
+.dose-card {
+  border-left: 0;
+  border-radius: 18px;
+  border-color: transparent;
+}
+.dose-row .dose-icon {
+  position: relative;
+  width: auto;
+  height: auto;
+  background: none;
+  border-radius: 0;
+}
+.dose-icon-check {
+  position: absolute;
+  right: -5px;
+  bottom: -5px;
+  width: 20px;
+  height: 20px;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  background: var(--success);
+  color: #fff;
+  border: 2px solid #fff;
+}
+.dose-row.is-skipped .medicine-art,
+.dose-icon.missed .medicine-art {
+  filter: grayscale(0.7);
+  opacity: 0.7;
+}
+.dose-row.just-taken .medicine-art {
+  animation: pill-lift 900ms var(--ease-out);
+}
+.dose-row.just-taken {
+  animation: taken-flash 900ms var(--ease-out);
+}
+@keyframes pill-lift {
+  0% {
+    transform: translateY(0);
+  }
+  35% {
+    transform: translateY(-10px) rotate(-8deg) scale(1.08);
+  }
+  100% {
+    transform: none;
+  }
+}
+@keyframes taken-flash {
+  0% {
+    background: color-mix(in srgb, var(--logo-afternoon) 30%, #fff);
+  }
+}
+
+/* ---------- Medicines ---------- */
+.med-card {
+  border-radius: 22px;
+}
+.med-top {
+  align-items: center;
+}
+.supply-gauge {
+  display: grid;
+  gap: 6px;
+  padding-top: var(--space-2);
+  border-top: 1px solid var(--border);
+}
+.supply-gauge-head {
+  display: flex;
+  justify-content: space-between;
+  font-size: var(--text-sm);
+}
+.supply-gauge-head small {
+  color: var(--muted);
+}
+.supply-gauge.low .supply-gauge-head b {
+  color: var(--warning);
+}
+.supply-track {
+  position: relative;
+  height: 8px;
+  border-radius: 999px;
+  background: var(--primary-soft);
+}
+.supply-fill {
+  position: absolute;
