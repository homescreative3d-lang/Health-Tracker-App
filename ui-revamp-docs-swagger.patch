+
+export function ForgotScreen({
+  onBack,
+  onSent,
+}: {
+  onBack: () => void;
+  onSent: (m: string) => void;
+}) {
+  const [e, setE] = useState(""),
+    [error, setError] = useState("");
+  return (
+    <section className="narrow-card">
+      <button className="icon-btn back" onClick={onBack} aria-label="Back">
