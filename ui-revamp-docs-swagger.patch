+            <User size={17} />
+            <span>Personal details</span>
+          </button>
+          <button
+            type="button"
+            className={activeSection === "history" ? "active" : ""}
+            onClick={() => setActiveSection("history")}
+          >
+            <Activity size={17} />
+            <span>Medical history</span>
+          </button>
+          <button
+            type="button"
+            className={activeSection === "attachments" ? "active" : ""}
