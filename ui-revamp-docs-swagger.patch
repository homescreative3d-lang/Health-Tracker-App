+/* Stylesheet entry point (order matters: tokens → base → layout → components → screens → motion). */
+@import "./tokens.css";
+@import "./base.css";
+@import "./layout.css";
+@import "./components.css";
+@import "./screens.css";
+@import "./motion.css";
diff --git a/frontend/src/styles/layout.css b/frontend/src/styles/layout.css
new file mode 100644
index 0000000..96ac23b
--- /dev/null
+++ b/frontend/src/styles/layout.css
@@ -0,0 +1,376 @@
+/*
+ * App layout. One breakpoint system for the whole app:
+ *   phone   < 640px   — top bar + bottom tab bar (safe-area aware for Android/iOS)
+ *   tablet  640–1023  — top bar + icon rail
+ *   desktop ≥ 1024    — top bar + labeled sidebar
+ * The same <AppNav> renders in every case, so items never change order or position.
+ */
+.app-shell {
+  min-height: 100dvh;
+}
+
+/* ---------- Top bar ---------- */
+.topbar {
+  position: sticky;
+  top: 0;
+  z-index: 30;
+  height: calc(var(--topbar-h) + var(--safe-top));
+  padding: var(--safe-top) clamp(14px, 3vw, 32px) 0;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3);
+  background: rgba(255, 255, 255, 0.92);
+  backdrop-filter: saturate(1.4) blur(12px);
+  border-bottom: 1px solid var(--border);
+}
+.brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  text-decoration: none;
+  color: var(--ink);
+  min-height: var(--tap);
+}
+.brand-mark {
+  width: 34px;
+  height: 34px;
+}
+.brand-name {
+  font-family: var(--font-display);
+  font-weight: 600;
+  font-size: 1.35rem;
+  letter-spacing: -0.01em;
+}
+.top-actions {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+}
+.help-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 40px;
+  padding: 0 14px;
+  border-radius: var(--radius-pill);
+  color: var(--ink-2);
+  font-weight: 700;
+  font-size: var(--text-sm);
+}
+.help-btn:hover {
+  background: var(--primary-tint);
+}
+.notification-btn {
+  position: relative;
+}
+.notification-dot {
+  position: absolute;
+  top: 5px;
+  right: 4px;
+  min-width: 16px;
+  height: 16px;
+  padding: 0 4px;
+  border-radius: var(--radius-pill);
+  background: var(--danger);
+  color: #fff;
+  font-size: 10px;
+  font-weight: 700;
+  line-height: 16px;
+  text-align: center;
+  border: 2px solid #fff;
+  box-sizing: content-box;
+}
+.account-menu {
+  position: relative;
+}
+.avatar-button {
+  border-radius: 50%;
+  min-width: var(--tap);
+  min-height: var(--tap);
+  display: grid;
+  place-items: center;
+}
+.account-dropdown {
+  position: absolute;
+  right: 0;
+  top: calc(100% + 8px);
+  width: 240px;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow-lg);
+  padding: 6px;
+  z-index: 40;
+}
+.account-dropdown-head {
+  display: grid;
+  padding: 10px 12px 12px;
+  border-bottom: 1px solid var(--border);
+  margin-bottom: 6px;
+}
+.account-dropdown-head small {
+  color: var(--muted);
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.account-dropdown button {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-height: var(--tap);
+  padding: 0 12px;
+  border-radius: var(--radius-sm);
+  font-weight: 700;
+  text-align: left;
+}
+.account-dropdown button:hover {
+  background: var(--primary-tint);
+}
+.account-dropdown-signout {
+  color: var(--danger);
+}
+
+/* ---------- Main areas ---------- */
+.main {
+  padding: clamp(16px, 4vw, 48px) clamp(14px, 4vw, 40px)
+    calc(clamp(24px, 4vw, 48px) + var(--safe-bottom));
+}
+.main.main-hub {
+  padding: 0;
+}
+.dashboard {
+  display: grid;
+  grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
+  min-height: calc(100dvh - var(--topbar-h) - var(--safe-top));
+}
+.dashboard-main {
+  min-width: 0;
+  padding: var(--space-6) clamp(16px, 3.5vw, 44px) var(--space-8);
+}
+.page-scroll,
+.dashboard-main > .patient-context-bar {
+  max-width: var(--content-max);
+  margin-inline: auto;
+}
+.page-scroll {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: var(--space-5);
+}
+/* Grid/flex children may shrink below their content width (prevents horizontal overflow). */
+.page-scroll > *,
+.calendar-nav,
+.calendar-strip {
+  min-width: 0;
+}
+
+/* ---------- Sidebar / rail ---------- */
+.sidebar {
+  position: sticky;
+  top: calc(var(--topbar-h) + var(--safe-top));
+  height: calc(100dvh - var(--topbar-h) - var(--safe-top));
+  overflow-y: auto;
+  padding: var(--space-6) var(--space-4);
+  border-right: 1px solid var(--border);
+  background: var(--surface);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-5);
+}
+.side-intro {
+  display: grid;
+  gap: 2px;
+  padding: var(--space-3) var(--space-3) var(--space-4);
+  border-radius: var(--radius);
+  background: var(--primary-tint);
+}
+.side-intro small {
+  color: var(--primary);
+  font-weight: 700;
+  font-size: var(--text-xs);
+}
+.side-intro b {
+  font-size: var(--text-lg);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.side-intro .muted {
+  font-size: var(--text-sm);
+}
+.side-nav {
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  gap: var(--space-4);
+}
+.side-nav ul {
+  display: grid;
+  gap: 4px;
+}
+.nav-item {
+  position: relative;
+  width: 100%;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: var(--tap);
+  padding: 0 14px;
+  border-radius: var(--radius-sm);
+  color: var(--ink-2);
+  font-weight: 700;
+  transition:
+    background var(--dur-fast),
+    color var(--dur-fast);
+}
+.nav-item:hover {
+  background: var(--primary-tint);
+  color: var(--ink);
+}
+.side-nav .nav-item.active {
+  background: var(--primary-soft);
+  color: var(--primary-strong);
+}
+.side-nav .nav-item.active::before {
+  content: "";
+  position: absolute;
+  left: -16px;
+  top: 10px;
+  bottom: 10px;
+  width: 4px;
+  border-radius: 0 4px 4px 0;
+  background: var(--primary);
+}
+.guide-link {
+  margin-top: auto;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-height: var(--tap);
+  padding: 0 14px;
+  border-radius: var(--radius-sm);
+  color: var(--muted);
+  font-weight: 700;
+  font-size: var(--text-sm);
+}
+.guide-link:hover {
+  color: var(--primary);
+  background: var(--primary-tint);
+}
+
+/* ---------- Bottom tab bar (phones) ---------- */
+.mobile-tabs {
+  display: none;
+}
+
+/* Tablet: icon rail */
+@media (max-width: 1023px) {
+  .dashboard {
+    grid-template-columns: var(--rail-w) minmax(0, 1fr);
+  }
+  .sidebar {
+    padding: var(--space-4) var(--space-2);
+    align-items: stretch;
+  }
+  .side-intro {
+    display: none;
+  }
+  .nav-item {
+    flex-direction: column;
+    justify-content: center;
+    gap: 4px;
+    min-height: 64px;
+    padding: 6px 4px;
+    font-size: var(--text-xs);
+    text-align: center;
+  }
+  .side-nav .nav-item.active::before {
+    left: -8px;
+  }
+  .guide-link span {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+  }
+  .guide-link {
+    justify-content: center;
+    padding: 0;
+  }
+}
+
+/* Phone: bottom tabs, no sidebar */
+@media (max-width: 639px) {
+  :root {
+    --topbar-h: 56px;
+  }
+  .help-btn span {
+    display: none;
+  }
+  .help-btn {
+    width: var(--tap);
+    padding: 0;
+    justify-content: center;
+  }
+  .brand-name {
+    font-size: 1.2rem;
+  }
+  .dashboard {
+    display: block;
+  }
+  .sidebar {
+    display: none;
+  }
+  .dashboard-main {
+    padding: var(--space-4) var(--space-4)
+      calc(var(--tabbar-h) + var(--safe-bottom) + var(--space-6));
+  }
+  .mobile-tabs {
+    display: block;
+    position: fixed;
+    inset: auto 0 0 0;
+    z-index: 30;
+    padding-bottom: var(--safe-bottom);
+    background: rgba(255, 255, 255, 0.96);
+    backdrop-filter: blur(12px);
+    border-top: 1px solid var(--border);
+    box-shadow: 0 -4px 16px rgba(18, 52, 59, 0.06);
+  }
+  .mobile-tabs ul {
+    display: grid;
+    grid-template-columns: repeat(5, 1fr);
+    height: var(--tabbar-h);
+  }
+  .mobile-tabs .nav-item {
+    height: 100%;
+    flex-direction: column;
+    justify-content: center;
+    gap: 3px;
+    padding: 0;
+    border-radius: 0;
+    font-size: 11.5px;
+    color: var(--muted);
+  }
+  .mobile-tabs .nav-item.active {
+    color: var(--primary-strong);
+    background: none;
+  }
+  .mobile-tabs .nav-item svg {
+    padding: 3px 14px;
+    width: 52px;
+    height: 30px;
+    border-radius: var(--radius-pill);
+    transition: background var(--dur);
+  }
+  .mobile-tabs .nav-item.active svg {
+    background: var(--primary-soft);
+  }
+  .account-dropdown {
+    position: fixed;
+    right: 12px;
+    top: calc(var(--topbar-h) + var(--safe-top) + 6px);
+  }
+}
diff --git a/frontend/src/styles/motion.css b/frontend/src/styles/motion.css
new file mode 100644
index 0000000..4e845d6
--- /dev/null
+++ b/frontend/src/styles/motion.css
@@ -0,0 +1,142 @@
+/*
+ * Motion. Animations answer a user action (tab change, dialog open, dose confirmed,
+ * message shown) rather than decorating idle content. The one orchestrated moment is
+ * the adherence ring filling on the Today screen. Everything is disabled for users who
+ * prefer reduced motion.
+ */
+@property --fill {
+  syntax: "<number>";
+  inherits: false;
+  initial-value: 0;
+}
+.progress-ring {
+  transition: --fill 700ms var(--ease-out);
+}
+@keyframes ring-fill {
+  from {
+    --fill: 0;
+  }
+}
+@keyframes spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+@keyframes fade-in {
+  from {
+    opacity: 0;
+  }
+}
+@keyframes rise {
+  from {
+    opacity: 0;
+    transform: translateY(6px);
+  }
+}
+@keyframes pop-in {
+  from {
+    opacity: 0;
+    transform: translateY(-4px) scale(0.97);
+  }
+}
+@keyframes sheet-up {
+  from {
+    transform: translateY(100%);
+  }
+}
+@keyframes dialog-in {
+  from {
+    opacity: 0;
+    transform: translateY(10px) scale(0.98);
+  }
+}
+@keyframes toast-in {
+  from {
+    opacity: 0;
+    transform: translate(-50%, 16px);
+  }
+}
+@keyframes confirm-pop {
+  0% {
+    transform: scale(0.6);
+  }
+  60% {
+    transform: scale(1.12);
+  }
+  100% {
+    transform: scale(1);
+  }
+}
+@keyframes heartbeat {
+  0%,
+  60%,
+  100% {
+    transform: scale(1);
+  }
+  15% {
+    transform: scale(1.08);
+  }
+  30% {
+    transform: scale(0.98);
+  }
+  45% {
+    transform: scale(1.05);
+  }
+}
+
+/* Tab change: a short fade so the content swap reads as navigation. */
+.view {
+  animation: fade-in var(--dur) var(--ease-out);
+}
+/* Dialogs */
+.modal-backdrop {
+  animation: fade-in var(--dur) ease-out;
+}
+.modal {
+  animation: dialog-in var(--dur) var(--ease-out);
+}
+@media (max-width: 639px) {
+  .modal {
+    animation: sheet-up 280ms var(--ease-out);
+  }
+}
+/* Menus and popovers grow from their trigger. */
+.account-dropdown {
+  transform-origin: top right;
+  animation: pop-in var(--dur-fast) var(--ease-out);
+}
+.notification-popover {
+  transform-origin: top right;
+  animation: pop-in var(--dur) var(--ease-out);
+}
+.suggestions {
+  animation: pop-in var(--dur-fast) var(--ease-out);
+}
+/* Wizard steps slide in as the user continues. */
+.step-panel {
+  animation: rise var(--dur) var(--ease-out);
+}
+/* Feedback */
+.toast {
+  animation: toast-in var(--dur) var(--ease-out);
+}
+.dose-icon.taken svg,
+.dose-row.is-taken .status-chip svg {
+  animation: confirm-pop 360ms var(--ease-out);
+}
+.inline-error,
+.settings-message,
+.family-message {
+  animation: rise var(--dur-fast) var(--ease-out);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
diff --git a/frontend/src/styles/screens.css b/frontend/src/styles/screens.css
new file mode 100644
index 0000000..4da4cb4
--- /dev/null
+++ b/frontend/src/styles/screens.css
@@ -0,0 +1,1334 @@
+/* Screen-specific styles. */
+
+/* ---------- Auth ---------- */
+.auth-layout {
+  max-width: 1080px;
+  margin: 0 auto;
+  min-height: calc(100dvh - var(--topbar-h) - 96px);
+  display: grid;
+  grid-template-columns: minmax(0, 1.05fr) minmax(0, 440px);
+  align-items: center;
+  gap: clamp(28px, 6vw, 80px);
+}
+.auth-copy {
+  display: grid;
+  gap: var(--space-5);
+  max-width: 34rem;
+}
+.auth-mark {
+  width: 56px;
+  height: 56px;
+}
+.auth-copy h1 {
+  font-size: clamp(2rem, 1.3rem + 2.6vw, 3.1rem);
+  line-height: 1.08;
+}
+.auth-copy p {
+  font-size: var(--text-lg);
+  color: var(--ink-2);
+  max-width: 46ch;
+}
+.feature-pills {
+  display: grid;
+  gap: var(--space-2);
+}
+.feature-pills li {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  font-weight: 700;
+  color: var(--ink-2);
+}
+/* Each feature gets a compartment color, echoing the dose groups inside the app. */
+.feature-pills li::before {
+  content: "";
+  width: 10px;
+  height: 10px;
+  border-radius: 3px;
+  background: var(--morning);
+}
+.feature-pills li:nth-child(2)::before {
+  background: var(--afternoon);
+}
+.feature-pills li:nth-child(3)::before {
+  background: var(--night);
+}
+.auth-card {
+  display: grid;
+  gap: var(--space-4);
+  padding: clamp(22px, 4vw, 32px);
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  box-shadow: var(--shadow);
+}
+.auth-card-head h2 {
+  margin-bottom: 2px;
+}
+.forgot {
+  display: flex;
+  justify-content: flex-end;
+  margin-top: -8px;
+}
+.narrow-card,
+.setup-card {
+  max-width: 460px;
+  margin: 0 auto;
+  display: grid;
+  gap: var(--space-4);
+  padding: clamp(22px, 4vw, 32px);
+}
+.setup-card {
+  max-width: 720px;
+}
+.role-grid {
+  display: grid;
+  gap: var(--space-3);
+}
+.role-card {
+  display: flex;
+  align-items: center;
+  gap: var(--space-4);
+  padding: var(--space-4);
+  text-align: left;
+  border-radius: var(--radius);
+  border: 1px solid var(--border-strong);
+  background: var(--surface);
+  transition:
+    border-color var(--dur-fast),
+    box-shadow var(--dur-fast);
+}
+.role-card:hover {
+  border-color: var(--primary);
+  box-shadow: var(--shadow);
+}
+.role-copy {
+  display: grid;
+  flex: 1;
+}
+.role-copy small {
+  color: var(--muted);
+}
+.role-icon {
+  width: 48px;
+  height: 48px;
+  display: grid;
+  place-items: center;
+  border-radius: var(--radius);
+  flex: none;
+}
+.role-icon.care {
+  background: var(--warning-soft);
+  color: var(--morning);
+}
+.role-icon.self {
+  background: var(--primary-soft);
+  color: var(--primary);
+}
+.patient-photo-field {
+  display: flex;
+  align-items: center;
+  gap: var(--space-4);
+  flex-wrap: wrap;
+}
+.doctor-photo-preview {
+  width: 160px;
+  max-height: 160px;
+  object-fit: cover;
+  border-radius: var(--radius);
+  border: 1px solid var(--border);
+}
+
+/* ---------- Today ---------- */
+.patient-switcher {
+  display: flex;
+  gap: var(--space-2);
+  overflow-x: auto;
+  padding-bottom: 4px;
+  scrollbar-width: none;
+}
+.patient-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  flex: none;
+  min-height: var(--tap);
+  padding: 4px 14px 4px 4px;
+  border-radius: var(--radius-pill);
+  background: var(--surface);
+  border: 1px solid var(--border);
+  font-weight: 700;
+}
+.patient-pill.active {
+  border-color: var(--primary);
+  background: var(--primary-soft);
+  color: var(--primary-strong);
+}
+.progress-card {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-5);
+  padding: var(--space-5);
+}
+.progress-copy {
+  display: grid;
+  gap: 6px;
+}
+.progress-stats {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2) var(--space-5);
+  font-size: var(--text-lg);
+}
+.stat b {
+  font-size: var(--text-xl);
+  margin-right: 4px;
+}
+.stat.taken b {
+  color: var(--success);
+}
+.stat.missed b {
+  color: var(--danger);
+}
+.progress-ring {
+  --size: 96px;
+  width: var(--size);
+  height: var(--size);
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  background:
+    radial-gradient(closest-side, var(--surface) 78%, transparent 79%),
+    conic-gradient(var(--primary) calc(var(--fill) * 1%), var(--primary-soft) 0);
+  font-weight: 700;
+  font-size: var(--text-lg);
+  animation: ring-fill var(--dur-slow) var(--ease-out) both;
+  --fill: var(--progress);
+}
+.section-heading h3 {
+  font-size: var(--text-lg);
+}
+
+/* Dose groups — pill organizer compartments */
+.dose-group {
+  --part: var(--primary);
+  display: grid;
+  gap: var(--space-2);
+}
+.part-morning {
+  --part: var(--morning);
+}
+.part-afternoon {
+  --part: var(--afternoon);
+}
+.part-evening {
+  --part: var(--evening);
+}
+.part-night {
+  --part: var(--night);
+}
+.dose-group h4 {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  color: var(--part);
+  font-size: var(--text-sm);
+}
+.dose-group-count {
+  min-width: 22px;
+  height: 22px;
+  padding: 0 6px;
+  border-radius: var(--radius-pill);
+  background: color-mix(in srgb, var(--part) 12%, white);
+  font-size: var(--text-xs);
+  line-height: 22px;
+  text-align: center;
+}
+.dose-card {
+  overflow: hidden;
+  border-left: 4px solid var(--part);
+}
+.dose-row {
+  display: flex;
+  gap: var(--space-3);
+  padding: var(--space-4);
+  transition: background var(--dur-slow);
+}
+.dose-row + .dose-row {
+  border-top: 1px solid var(--border);
+}
+.dose-row.is-taken {
+  background: linear-gradient(90deg, var(--success-soft), transparent 70%);
+}
+.dose-icon {
+  width: 44px;
+  height: 44px;
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: var(--radius);
+  background: var(--primary-tint);
+  color: var(--primary);
+}
+.dose-icon.due {
+  background: var(--warning-soft);
+  color: var(--warning);
+}
+.dose-row:has(.dose-icon.due) {
+  background: linear-gradient(90deg, var(--warning-soft), transparent 60%);
+}
+.dose-icon.taken {
+  background: var(--success-soft);
+  color: var(--success);
+}
+.dose-icon.skipped,
+.dose-icon.missed {
+  background: var(--danger-soft);
+  color: var(--danger);
+}
+.dose-main {
+  flex: 1;
+  min-width: 0;
+  display: grid;
+  gap: var(--space-2);
+}
+.dose-top {
+  display: flex;
+  justify-content: space-between;
+  gap: var(--space-3);
+}
+.dose-title {
+  display: grid;
+  min-width: 0;
+}
+.dose-title .muted {
+  font-size: var(--text-sm);
+}
+.dose-time {
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+.dose-foot {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-2);
+  flex-wrap: wrap;
+}
+.dose-actions {
+  display: flex;
+  gap: var(--space-2);
+}
+.dose-hint {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: var(--text-sm);
+  color: var(--muted);
+}
+.add-btn {
+  border-style: dashed;
+}
+
+/* ---------- Calendar ---------- */
+.calendar-picker {
+  position: relative;
+  overflow: hidden;
+}
+.calendar-picker input {
+  border: 0;
+  background: none;
+  min-height: 40px;
+  font-weight: 700;
+}
+.calendar-nav {
+  display: flex;
+  align-items: center;
+  gap: var(--space-1);
+}
+.calendar-strip {
+  flex: 1;
+  display: flex;
+  gap: var(--space-2);
+  overflow-x: auto;
+  scroll-snap-type: x proximity;
+  padding: 4px 2px;
+  scrollbar-width: none;
+}
+.calendar-strip::-webkit-scrollbar {
+  display: none;
+}
+.calendar-day {
+  flex: none;
+  width: 56px;
+  min-height: 68px;
+  display: grid;
+  place-content: center;
+  gap: 2px;
+  scroll-snap-align: center;
+  border-radius: var(--radius);
+  background: var(--surface);
+  border: 1px solid var(--border);
+  font-size: var(--text-xs);
+  color: var(--muted);
+  transition:
+    background var(--dur-fast),
+    color var(--dur-fast),
+    transform var(--dur-fast);
+}
+.calendar-day b {
+  font-size: var(--text-lg);
+  color: var(--ink);
+}
+.calendar-day.is-today {
+  border-color: var(--primary);
+}
+.calendar-day.active {
+  background: var(--primary);
+  border-color: var(--primary);
+  color: rgba(255, 255, 255, 0.85);
+  transform: translateY(-2px);
+}
+.calendar-day.active b {
+  color: #fff;
+}
+.calendar-summary {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3);
+}
+.calendar-summary > div {
+  display: grid;
+}
+.calendar-summary strong {
+  font-size: var(--text-lg);
+}
+.pause-panel {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-4);
+  flex-wrap: wrap;
+  padding: var(--space-4) var(--space-5);
+}
+.pause-panel-copy {
+  display: flex;
+  gap: var(--space-3);
+  flex: 1 1 280px;
+}
+.pause-panel-copy p {
+  font-size: var(--text-sm);
+}
+.pause-panel-icon {
+  width: 40px;
+  height: 40px;
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: var(--radius);
+  background: var(--info-soft);
+  color: var(--info);
+}
+.pause-controls {
+  display: flex;
+  gap: var(--space-2);
+  flex: 1 1 300px;
+}
+.pause-controls .input {
+  flex: 1;
+}
+
+/* ---------- Medicines ---------- */
+.medicine-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
+  gap: var(--space-4);
+}
+.med-card {
+  display: grid;
+  gap: var(--space-3);
+  padding: var(--space-4);
+  align-content: start;
+}
+.med-card.is-paused {
+  background: var(--surface-2);
+}
+.med-card.is-paused .dose-icon {
+  filter: grayscale(1);
+  opacity: 0.6;
+}
+.med-top {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--space-3);
+}
+.med-info {
+  display: grid;
+  flex: 1;
+  min-width: 0;
+  font-size: var(--text-sm);
+}
+.med-info b {
+  font-size: var(--text-lg);
+}
+.med-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+.med-meta span {
+  padding: 3px 10px;
+  border-radius: var(--radius-pill);
+  background: var(--primary-tint);
+  font-size: var(--text-sm);
+  color: var(--ink-2);
+}
+.supply {
+  display: flex;
+  justify-content: space-between;
+  font-size: var(--text-sm);
+  color: var(--muted);
+  padding-top: var(--space-2);
+  border-top: 1px solid var(--border);
+}
+.supply.low {
+  color: var(--warning);
+}
+.med-actions {
+  display: flex;
+  gap: var(--space-2);
+}
+.med-actions .btn {
+  flex: 1;
+}
+
+/* ---------- Profile ---------- */
+.profile-section {
+  display: grid;
+  gap: var(--space-4);
+}
+.card.profile-section {
+  padding: var(--space-5);
+}
+.profile-head {
+  display: flex;
+  align-items: center;
+  gap: var(--space-4);
+  flex-wrap: wrap;
+}
+.profile-head > div {
+  display: grid;
+  flex: 1;
+  min-width: 180px;
+}
+.profile-head > div b {
+  font-size: var(--text-lg);
+}
+.patient-cards {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
+  gap: var(--space-3);
+}
+.patient-summary-row {
+  display: flex;
+  align-items: center;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  transition:
+    border-color var(--dur-fast),
+    box-shadow var(--dur-fast);
+}
+.patient-summary-row:hover {
+  border-color: var(--primary);
+  box-shadow: var(--shadow);
+}
+.patient-summary-card {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  padding: var(--space-3) var(--space-2) var(--space-3) var(--space-4);
+  text-align: left;
+}
+.patient-summary-copy {
+  display: grid;
+  flex: 1;
+  min-width: 0;
+}
+.patient-summary-copy small {
+  color: var(--muted);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.patient-open-label {
+  display: inline-flex;
+  align-items: center;
+  font-size: var(--text-sm);
+  font-weight: 700;
+  color: var(--primary);
+}
+.patient-edit-shortcut {
+  margin-right: 6px;
+}
+.self-care-prompt {
+  display: flex;
+  align-items: center;
+  gap: var(--space-4);
+  padding: var(--space-4) var(--space-5);
+  flex-wrap: wrap;
+}
+.self-care-prompt > svg {
+  color: var(--primary);
+  flex: none;
+}
+.self-care-prompt > div {
+  flex: 1 1 240px;
+}
+.profile-tools {
+  padding: var(--space-2) !important;
+  gap: 0 !important;
+}
+.profile-action {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  width: 100%;
+  min-height: 64px;
+  padding: var(--space-2) var(--space-3);
+  border-radius: var(--radius-sm);
+  text-align: left;
+}
+.profile-action:hover {
+  background: var(--primary-tint);
+}
+.profile-action + .profile-action {
+  border-top: 1px solid var(--border);
+}
+.profile-action-icon {
+  width: 40px;
+  height: 40px;
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: var(--radius);
+  background: var(--primary-soft);
+  color: var(--primary);
+}
+.profile-action-copy {
+  display: grid;
+  flex: 1;
+}
+.profile-action-copy small {
+  color: var(--muted);
+}
+.delete-account-section {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-4);
+  flex-wrap: wrap;
+  padding: var(--space-5);
+  border-color: #f0cfcd;
+}
+.delete-account-copy {
+  display: flex;
+  gap: var(--space-3);
+  flex: 1 1 320px;
+}
+.delete-account-copy p {
+  font-size: var(--text-sm);
+  max-width: 60ch;
+}
+.delete-account-icon {
+  width: 40px;
+  height: 40px;
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: var(--radius);
+  background: var(--danger-soft);
+  color: var(--danger);
+}
+.account-edit-card {
+  display: grid;
+  gap: var(--space-4);
+  padding: var(--space-5);
+  max-width: 640px;
+}
+
+/* ---------- Patient details workspace ---------- */
+.patient-info-workspace {
+  display: grid;
+  grid-template-columns: 220px minmax(0, 1fr);
+  gap: var(--space-5);
+  align-items: start;
+}
+.patient-info-nav {
+  position: sticky;
+  top: calc(var(--topbar-h) + var(--safe-top) + 16px);
+  display: grid;
+  gap: 4px;
+  padding: var(--space-2);
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+}
+.patient-info-nav-label {
+  padding: 6px 10px;
+  font-size: var(--text-xs);
+  font-weight: 700;
+  color: var(--muted);
+}
+.patient-info-nav button {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-height: var(--tap);
+  padding: 0 10px;
+  border-radius: var(--radius-sm);
+  font-weight: 700;
+  color: var(--ink-2);
+  text-align: left;
+}
+.patient-info-nav button span {
+  flex: 1;
+}
+.patient-info-nav button small {
+  min-width: 22px;
+  padding: 0 6px;
+  border-radius: var(--radius-pill);
+  background: var(--primary-soft);
+  color: var(--primary-strong);
+  text-align: center;
+}
+.patient-info-nav button:hover {
+  background: var(--primary-tint);
+}
+.patient-info-nav button.active {
+  background: var(--primary-soft);
+  color: var(--primary-strong);
+}
+.patient-info-content {
+  display: grid;
+  gap: var(--space-4);
+  min-width: 0;
+}
+.patient-info-section {
+  display: grid;
+  gap: var(--space-4);
+  padding: var(--space-5);
+}
+.patient-info-section-head {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+}
+.patient-info-section-head > div {
+  flex: 1;
+}
+.patient-info-section-head p {
+  font-size: var(--text-sm);
+}
+.patient-info-section-icon {
+  width: 40px;
+  height: 40px;
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: var(--radius);
+  background: var(--primary-soft);
+  color: var(--primary);
+}
+.medicine-count-pill {
+  padding: 2px 10px;
+  border-radius: var(--radius-pill);
+  background: var(--primary-soft);
+  color: var(--primary-strong);
+  font-weight: 700;
+}
+.patient-info-identity {
+  display: flex;
+  gap: var(--space-4);
+  align-items: center;
+  flex-wrap: wrap;
+}
+.patient-info-identity > div {
+  display: grid;
+  gap: 6px;
+}
+.patient-info-identity small {
+  color: var(--muted);
+}
+.patient-profile-photo {
+  width: 88px;
+  height: 88px;
+  flex: none;
+  border-radius: 50%;
+  overflow: hidden;
+  display: grid;
+  place-items: center;
+  background: var(--primary-soft);
+  color: var(--primary-strong);
+  font-weight: 700;
+  font-size: 28px;
+}
+.patient-profile-photo img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+.patient-edit-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+}
+.patient-edit-grid > .field:has(textarea),
+.patient-edit-grid > .full-field {
+  grid-column: 1 / -1;
+}
+.patient-details-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  overflow: hidden;
+}
+.detail-row {
+  display: grid;
+  gap: 2px;
+  padding: 12px 14px;
+  border-bottom: 1px solid var(--border);
+}
+.detail-row:nth-child(odd) {
+  border-right: 1px solid var(--border);
+}
+.detail-row .muted {
+  font-size: var(--text-sm);
+}
+.medical-history-flow {
+  display: grid;
+  gap: 0;
+  position: relative;
+}
+.medical-history-node {
+  position: relative;
+  display: flex;
+  gap: var(--space-3);
+  padding-bottom: var(--space-4);
+  animation: rise var(--dur) var(--ease-out) both;
+}
+.medical-history-node:not(:last-child)::before {
+  content: "";
+  position: absolute;
+  left: 15px;
+  top: 32px;
+  bottom: 0;
+  width: 2px;
+  background: var(--border);
+}
+.medical-history-node-dot {
+  width: 32px;
+  height: 32px;
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  background: var(--primary-soft);
+  color: var(--primary-strong);
+  font-weight: 700;
+  font-size: var(--text-sm);
+}
+.medical-history-node > div {
+  display: grid;
+}
+.medical-history-node small {
+  color: var(--muted);
+}
+.patient-section-empty {
+  padding: var(--space-5);
+  border-radius: var(--radius);
+  background: var(--surface-2);
+  color: var(--muted);
+  text-align: center;
+}
+.doctor-photo-detail img {
+  max-width: 220px;
+  border-radius: var(--radius);
+}
+.attachment-add-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+}
+.patient-attachments-list,
+.ongoing-medicine-list {
+  display: grid;
+  gap: var(--space-2);
+}
+.patient-attachment-row,
+.ongoing-medicine-row {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  padding: var(--space-3);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+}
+.attachment-file-icon {
+  width: 40px;
+  height: 40px;
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: var(--radius-sm);
+  background: var(--info-soft);
+  color: var(--info);
+}
+.attachment-file-copy,
+.ongoing-medicine-copy {
+  display: grid;
+  flex: 1;
+  min-width: 0;
+}
+.attachment-file-copy b {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.attachment-file-copy small,
+.ongoing-medicine-copy small,
+.ongoing-medicine-copy span {
+  color: var(--muted);
+  font-size: var(--text-sm);
+}
+.attachment-download {
+  text-decoration: none;
+}
+.patient-edit-footer {
+  position: sticky;
+  bottom: 0;
+  display: flex;
+  justify-content: flex-end;
+  gap: var(--space-2);
+  padding: var(--space-3) 0;
+  background: linear-gradient(transparent, var(--bg) 30%);
+}
+
+/* ---------- History ---------- */
+.history-filters {
+  display: grid;
+  gap: var(--space-4);
+  padding: var(--space-5);
+}
+.history-filter-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
+  gap: var(--space-3);
+  align-items: end;
+}
+.history-results-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+}
+.history-results-head > div {
+  display: flex;
+  gap: var(--space-3);
+  align-items: baseline;
+}
+.history-table-wrap {
+  overflow: hidden;
+}
+.history-table-scroll {
+  overflow-x: auto;
+}
+.history-data-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: var(--text-sm);
+}
+.history-data-table th {
+  text-align: left;
+  padding: 12px 16px;
+  background: var(--surface-2);
+  color: var(--muted);
+  font-weight: 700;
+  border-bottom: 1px solid var(--border);
+  white-space: nowrap;
+}
+.history-data-table td {
+  padding: 12px 16px;
+  border-bottom: 1px solid var(--border);
+  vertical-align: middle;
+}
+.history-data-table tbody tr:last-child td {
+  border-bottom: 0;
+}
+.history-data-table tbody tr:hover {
+  background: var(--primary-tint);
+}
+.history-data-table td small {
+  display: block;
+  color: var(--muted);
+}
+.history-patient-cell,
+.history-medication {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+.history-medication .dose-icon {
+  width: 34px;
+  height: 34px;
+}
+.history-avatar {
+  width: 32px;
+  height: 32px;
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  background: var(--primary-soft);
+  color: var(--primary-strong);
+  font-size: 12px;
+  font-weight: 700;
+}
+.history-status {
+  display: inline-block;
+  padding: 3px 10px;
+  border-radius: var(--radius-pill);
+  font-weight: 700;
+}
+.history-status.taken {
+  background: var(--success-soft);
+  color: var(--success);
+}
+.history-status.missed {
+  background: var(--danger-soft);
+  color: var(--danger);
+}
+.history-status.pending {
+  background: var(--warning-soft);
+  color: var(--warning);
+}
+.history-empty {
+  display: grid;
+  justify-items: center;
+  gap: var(--space-2);
+  padding: var(--space-8) var(--space-4);
+  text-align: center;
+}
+
+/* ---------- Family ---------- */
+.family-card {
+  display: grid;
+  gap: var(--space-5);
+  padding: var(--space-5);
+}
+.family-heading > svg {
+  color: var(--primary);
+}
+.family-create {
+  display: flex;
+  gap: var(--space-3);
+  align-items: flex-end;
+  flex-wrap: wrap;
+}
+.family-create .field {
+  flex: 1 1 260px;
+}
+.family-name {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: var(--space-3);
+  padding: var(--space-4);
+  border-radius: var(--radius);
+  background: var(--primary-tint);
+}
+.family-name > div {
+  display: grid;
+}
+.family-name b {
+  font-size: var(--text-lg);
+}
+.family-search {
+  display: flex;
+  gap: var(--space-2);
+  align-items: flex-end;
+}
+.family-search .field {
+  flex: 1;
+}
+.family-results,
+.family-members,
+.family-notifications {
+  display: grid;
+  gap: var(--space-2);
+}
+.family-result,
+.family-member,
+.family-request {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  padding: var(--space-3);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+}
+.family-result > div:not(.avatar),
+.family-member > div,
+.family-request > div {
+  display: grid;
+  flex: 1;
+  min-width: 0;
+}
+.family-result span,
+.family-member span:not([class*="status"]):not(.avatar) {
+  color: var(--muted);
+  font-size: var(--text-sm);
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.family-result .avatar,
+.small-avatar {
+  width: 40px;
+  height: 40px;
+  border-radius: 50%;
+  object-fit: cover;
+}
+.family-member-person {
+  display: flex !important;
+  align-items: center;
+  gap: var(--space-3);
+}
+.family-member-person > div {
+  display: grid;
+}
+.family-subhead {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+.family-message {
+  padding: 10px 12px;
+  border-radius: var(--radius-sm);
+  background: var(--info-soft);
+  color: var(--info);
+  font-weight: 700;
+  font-size: var(--text-sm);
+}
+.family-request {
+  align-items: flex-start;
+  background: var(--warning-soft);
+  border-color: #f0d9ad;
+}
+.family-request p {
+  font-size: var(--text-sm);
+  margin-bottom: var(--space-2);
+}
+
+/* ---------- Notifications page ---------- */
+.notification-settings,
+.notification-inbox {
+  display: grid;
+  gap: var(--space-4);
+  padding: var(--space-5);
+}
+.notification-items {
+  display: grid;
+  gap: var(--space-2);
+}
+.notification-item {
+  display: flex;
+  justify-content: space-between;
+  gap: var(--space-3);
+  padding: var(--space-3);
+  border-left: 3px solid var(--primary);
+  background: var(--surface-2);
+  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
+}
+.notification-item.type-dose_missed,
+.notification-item.type-notification_failed {
+  border-left-color: var(--danger);
+}
+.notification-item.type-refill_low {
+  border-left-color: var(--morning);
+}
+.notification-item p {
+  font-size: var(--text-sm);
+  color: var(--ink-2);
+}
+.notification-item small {
+  color: var(--muted);
+  white-space: nowrap;
+}
+
+/* ---------- Guide ---------- */
+.guide-list {
+  display: grid;
+  gap: var(--space-4);
+}
+.guide-step {
+  display: flex;
+  gap: var(--space-3);
+}
+.guide-step > span {
+  width: 32px;
+  height: 32px;
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  background: var(--primary);
+  color: #fff;
+  font-weight: 700;
+}
+.guide-note {
+  display: flex;
+  gap: var(--space-3);
+  padding: var(--space-4);
+  border-radius: var(--radius);
+  background: var(--primary-tint);
+  font-size: var(--text-sm);
+  color: var(--ink-2);
+}
+.guide-note svg {
+  color: var(--primary);
+  flex: none;
+}
+
+/* ---------- Splash ---------- */
+.loading-mark {
+  width: 72px;
+  height: 72px;
+  animation: heartbeat 1.6s var(--ease-out) infinite;
+}
+
+/* ---------- Tablet ---------- */
+@media (max-width: 1023px) {
+  .auth-layout {
+    grid-template-columns: 1fr;
+    max-width: 560px;
+    min-height: 0;
+  }
+  .auth-copy h1 {
+    font-size: clamp(1.8rem, 1.2rem + 2.4vw, 2.4rem);
+  }
+  .patient-info-workspace {
+    grid-template-columns: 1fr;
+  }
+  .patient-info-nav {
+    position: static;
+    display: flex;
+    overflow-x: auto;
+    scrollbar-width: none;
+  }
+  .patient-info-nav-label {
+    display: none;
+  }
+  .patient-info-nav button {
+    flex: none;
+  }
+  .history-filter-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+/* ---------- Phone ---------- */
+@media (max-width: 639px) {
+  .auth-copy p,
+  .feature-pills {
+    display: none;
+  }
+  .auth-copy {
+    gap: var(--space-3);
+  }
+  .auth-mark {
+    width: 44px;
+    height: 44px;
+  }
+  .progress-card {
+    padding: var(--space-4);
+  }
+  .progress-ring {
+    --size: 76px;
+    font-size: var(--text-md);
+  }
+  .dose-row {
+    padding: var(--space-3);
+  }
+  .dose-icon {
+    width: 40px;
+    height: 40px;
+  }
+  .dose-foot {
+    align-items: stretch;
+  }
+  .dose-actions {
+    width: 100%;
+  }
+  .dose-actions .btn {
+    flex: 1;
+    min-height: var(--tap);
+  }
+  .calendar-nav .icon-btn {
+    display: none;
+  }
+  .pause-controls {
+    flex-direction: column;
+  }
+  .patient-edit-grid,
+  .patient-details-grid,
+  .history-filter-grid {
+    grid-template-columns: 1fr;
+  }
+  .detail-row:nth-child(odd) {
+    border-right: 0;
+  }
+  .history-clear {
+    width: 100%;
+  }
+  /* History table becomes stacked cards */
+  .history-data-table thead {
+    display: none;
+  }
+  .history-data-table,
+  .history-data-table tbody,
+  .history-data-table tr,
+  .history-data-table td {
+    display: block;
+  }
+  .history-data-table tr {
+    padding: var(--space-3) var(--space-4);
+    border-bottom: 1px solid var(--border);
+  }
+  .history-data-table td {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: var(--space-3);
+    padding: 6px 0;
+    border: 0;
+  }
+  .history-data-table td::before {
+    content: attr(data-label);
+    color: var(--muted);
+    font-weight: 700;
+    font-size: var(--text-xs);
+  }
+  .family-search {
+    flex-direction: column;
+    align-items: stretch;
+  }
+  .med-actions {
+    flex-wrap: wrap;
+  }
+}
diff --git a/frontend/src/styles/tokens.css b/frontend/src/styles/tokens.css
new file mode 100644
index 0000000..9db34f0
--- /dev/null
+++ b/frontend/src/styles/tokens.css
@@ -0,0 +1,83 @@
+/*
+ * Design tokens — Tended "clinic morning" theme.
+ * Calm clinical teal for actions, pine ink for text, cool pale surfaces, and
+ * accessible status colors (all text/background pairs meet WCAG AA).
+ * Daypart colors mirror the compartments of a weekly pill organizer.
+ */
+
+:root {
+  /* Brand */
+  --primary: #0f766e; /* 5.4:1 on white */
+  --primary-strong: #0b5a54;
+  --primary-soft: #e3f1ee;
+  --primary-tint: #f0f7f5;
+  --focus: #1d8ad6;
+
+  /* Neutrals */
+  --bg: #f4f8f7;
+  --surface: #ffffff;
+  --surface-2: #f8fbfa;
+  --ink: #12343b; /* 12.6:1 on white */
+  --ink-2: #2f4f55;
+  --muted: #5b7378; /* 4.9:1 on white */
+  --border: #d9e5e2;
+  --border-strong: #c3d5d1;
+
+  /* Status */
+  --success: #2f7a4f;
+  --success-soft: #e5f4ea;
+  --danger: #b4403a;
+  --danger-soft: #fcebea;
