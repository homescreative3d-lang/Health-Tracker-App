diff --git a/frontend/src/styles/activity.css b/frontend/src/styles/activity.css
new file mode 100644
index 0000000..f589ea9
--- /dev/null
+++ b/frontend/src/styles/activity.css
@@ -0,0 +1,341 @@
+/*
+ * Activity-driven feedback: every action in the app answers with its own short motion.
+ * Also the due-now highlight, reschedule markings and skipped-vs-missed colors.
+ * All motion is disabled by the reduced-motion rule in motion.css.
+ */
+
+/* ---------- Skipped gets its own color (amber), separate from missed (coral) ---------- */
+.status-skipped {
+  background: #fdf3e1;
+  color: #8a5a0b;
+}
+.stat.skipped b {
+  color: var(--morning);
+}
+.progress-bar .skipped {
+  background: var(--logo-morning);
+}
+.history-status.skipped {
+  background: #fdf3e1;
+  color: #8a5a0b;
+}
+.history-status.moved {
+  background: var(--info-soft);
+  color: var(--info);
+}
+.timeline-item.st-skipped .timeline-dot {
+  background: #fff;
+  border-color: var(--logo-morning);
+  border-style: dashed;
+}
+.timeline-item.st-missed .timeline-dot {
+  border-color: var(--logo-evening);
+}
+.timeline-item.st-rescheduled .timeline-dot {
+  border-color: var(--logo-night);
+}
+
+/* ---------- Patient-wise status line ---------- */
+.dose-status {
+  display: inline-flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px 10px;
+}
+.recorded-by {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  color: var(--muted);
+  font-size: var(--text-xs);
+}
+
+/* ---------- Reschedule markings ---------- */
+.resched-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  margin-left: 8px;
+  padding: 2px 8px;
+  border-radius: 999px;
+  background: var(--info-soft);
+  color: var(--night);
+  font-size: 11px;
+  font-weight: 600;
+  vertical-align: middle;
+  box-shadow: inset 0 0 0 1px rgba(76, 91, 212, 0.25);
+}
+.resched-from {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  color: var(--night);
+  font-size: var(--text-xs);
+  font-weight: 500;
+}
+.dose-row.is-rescheduled {
+  background: repeating-linear-gradient(-45deg, #f9fafc 0 10px, #f3f5fa 10px 20px);
+}
+.dose-row.is-rescheduled .dose-title b,
+.dose-row.is-rescheduled .muted {
+  opacity: 0.7;
+}
+.dose-time.struck {
+  text-decoration: line-through;
+  text-decoration-color: var(--night);
+  color: var(--muted);
+}
+.dose-row:has(.resched-badge) {
+  box-shadow: inset 3px 0 0 var(--logo-night);
+}
+.med-card.is-rescheduled {
+  box-shadow:
+    inset 0 3px 0 var(--logo-night),
+    0 1px 2px rgba(15, 42, 51, 0.04);
+}
+.resched-note {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px;
+}
+.resched-note .resched-badge {
+  margin-left: 0;
+}
+.resched-note small {
+  color: var(--muted);
+  font-size: var(--text-xs);
+}
+
+/* ---------- Due-now highlight ---------- */
+.dose-row.is-due-now {
+  position: relative;
+  z-index: 1;
+  border-radius: 16px;
+  background: linear-gradient(90deg, #fff7e8, #fff 70%);
+  box-shadow:
+    0 0 0 2px var(--logo-morning),
+    0 10px 24px -10px rgba(242, 169, 59, 0.6);
+  animation: due-glow 2s ease-in-out infinite;
+}
+.dose-row.is-due-now + .dose-row {
+  border-top-color: transparent;
+}
+.dose-row.is-due-now .status-chip::before {
+  content: "";
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--logo-morning);
+  animation: heartbeat 1.4s ease-in-out infinite;
+}
+@keyframes due-glow {
+  0%,
+  100% {
+    box-shadow:
+      0 0 0 2px var(--logo-morning),
+      0 10px 24px -10px rgba(242, 169, 59, 0.6);
+  }
+  50% {
+    box-shadow:
+      0 0 0 4px rgba(242, 169, 59, 0.55),
+      0 14px 30px -10px rgba(242, 169, 59, 0.75);
+  }
+}
+
+/* ---------- Action animations ---------- */
+.dose-row.just-skipped {
+  animation: skip-slide 700ms var(--ease-out);
+}
+.dose-row.just-skipped .medicine-art {
+  animation: skip-tilt 700ms var(--ease-out);
+}
+@keyframes skip-slide {
+  0% {
+    transform: translateX(0);
+    background: #fdf3e1;
+  }
+  30% {
+    transform: translateX(10px);
+  }
+  100% {
+    transform: none;
+  }
+}
+@keyframes skip-tilt {
+  40% {
+    transform: rotate(-18deg) scale(0.9);
+    opacity: 0.5;
+  }
+}
+.dose-row.just-moved {
+  animation: move-out 800ms var(--ease-out);
+}
+.dose-row.just-moved .dose-icon {
+  animation: move-icon 800ms var(--ease-out);
+}
+@keyframes move-out {
+  0% {
+    background: var(--info-soft);
+  }
+}
+@keyframes move-icon {
+  40% {
+    transform: translateX(16px) rotate(12deg);
+    opacity: 0.4;
+  }
+}
+.dose-row.just-undone .medicine-art {
+  animation: rewind 700ms var(--ease-out);
+}
+@keyframes rewind {
+  0% {
+    transform: rotate(0);
+  }
+  60% {
+    transform: rotate(-300deg) scale(0.9);
+  }
+  100% {
+    transform: rotate(-360deg);
+  }
+}
+.undo-btn:hover svg {
+  animation: rewind 600ms var(--ease-out);
+}
+
+/* New or rescheduled medicine card pops in and glows once */
+.med-card.is-new {
+  animation:
+    card-pop 520ms var(--ease-out),
+    card-glow 1.8s 200ms ease-out;
+}
+@keyframes card-pop {
+  from {
+    transform: scale(0.94);
+    opacity: 0;
+  }
+}
+@keyframes card-glow {
+  0% {
+    box-shadow: 0 0 0 0 rgba(11, 122, 110, 0.5);
+  }
+  70% {
+    box-shadow: 0 0 0 10px rgba(11, 122, 110, 0);
+  }
+}
+
+/* Notification bell rings when something new arrives */
+.notification-btn.ringing svg {
+  animation: bell-ring 1.1s ease-in-out;
+  transform-origin: 50% 2px;
+}
+.notification-btn.ringing .notification-dot {
+  animation: confirm-pop 420ms var(--ease-out);
+}
+
+/* Save buttons morph into a check */
+.btn.is-saved {
+  background: var(--success);
+  animation: confirm-pop 360ms var(--ease-out);
+}
+
+/* Icon-only delete keeps the action row tidy */
+.btn.icon-only {
+  flex: 0 0 var(--tap) !important;
+  width: var(--tap);
+  padding: 0;
+}
+
+/* ---------- Reschedule dialog ---------- */
+.resched-tabs button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+}
+.resched-panel {
+  display: grid;
+  gap: var(--space-4);
+  animation: rise 280ms var(--ease-out);
+}
+.resched-preview {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  align-items: center;
+  gap: var(--space-3);
+  padding: var(--space-3);
+  border-radius: 18px;
+  background: #0f2a33;
+}
+.resched-slot {
+  display: grid;
+  gap: 2px;
+  padding: 12px 14px;
+  border-radius: 14px;
+  background: rgba(255, 255, 255, 0.08);
+  color: #fff;
+}
+.resched-slot small {
+  color: rgba(255, 255, 255, 0.6);
+  font-size: var(--text-xs);
+}
+.resched-slot span {
+  color: rgba(255, 255, 255, 0.8);
+}
+.resched-slot.from b,
+.resched-slot.from span {
+  text-decoration: line-through;
+  text-decoration-color: rgba(255, 255, 255, 0.4);
+}
+.resched-slot.to {
+  border: 1px dashed rgba(255, 255, 255, 0.25);
+}
+.resched-slot.to.ready {
+  border: 0;
+  background: #fff;
+  color: var(--ink);
+  animation: confirm-pop 320ms var(--ease-out);
+}
+.resched-slot.to.ready small,
+.resched-slot.to.ready span {
+  color: var(--night);
+}
+.resched-arrow {
+  color: #7fd6c4;
+  animation: nudge 1.4s ease-in-out infinite;
+}
+@keyframes nudge {
+  50% {
+    transform: translateX(4px);
+  }
+}
+.time-empty {
+  font-style: italic;
+}
+
+@media (max-width: 639px) {
+  .resched-preview {
+    grid-template-columns: 1fr;
+  }
+  .resched-arrow {
+    rotate: 90deg;
+    justify-self: center;
+  }
+  .dose-actions {
+    flex-wrap: wrap;
+  }
+}
+
+/* Medicine cards: never let content push past the card (grid children default to min-content). */
+.med-card,
+.med-card > * {
+  min-width: 0;
+}
+.med-actions {
+  flex-wrap: nowrap;
+}
+.med-actions .btn:not(.icon-only) {
+  flex: 1 1 0;
+  min-width: 0;
+  padding: 0 12px;
+}
