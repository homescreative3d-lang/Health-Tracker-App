+    setBusy(true);
+    try {
+      const u = await api.updateProfile({
+        displayName: displayName.trim(),
+        profileImageUrl: image,
+      });
+      onSave(u);
+      setMsg("Details saved.");
+    } catch (e) {
+      setMsg(err(e));
+    } finally {
+      setBusy(false);
+    }
+  };
+  const initials = (displayName || "?")
+    .split(" ")
+    .map((x) => x[0])
+    .slice(0, 2)
+    .join("");
+  return (
+    <div className="page-scroll">
+      <div className="page-head">
+        <div>
