+          className="input"
+          value={e}
+          onChange={(x) => setE(x.target.value)}
+          placeholder="you@email.com"
+          type="email"
+        />
+      </Field>
+      {error && <InlineError>{error}</InlineError>}
+      <button
+        className="btn primary full"
+        onClick={async () => {
