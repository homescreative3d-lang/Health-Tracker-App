# Local development only. Never use these sample values in production.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=tended_dev;Username=tended;Password=tended_local_only;Include Error Detail=true
Frontend__Url=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Development

# Optional for local development. Push reminders are disabled without VAPID keys.
WebPush__Subject=mailto:notifications@tended.app
WebPush__PublicKey=
WebPush__PrivateKey=

# Optional for image upload. API can run locally without object storage,
# but profile/patient image uploads require valid S3-compatible storage credentials.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
